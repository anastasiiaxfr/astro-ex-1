---
const { data, uri, active = 'all' } = Astro.props;
---

<div class="tags">
	<nav class="tags__inner">
		{
			data.map(({ slug, title }) => (
				<a
					class={active === slug ? 'tag active' : 'tag'}
					data-category={slug}
					href={slug === 'all' ? uri : `${uri}${slug}`}
				>
					{title}
				</a>
			))
		}
	</nav>
</div>
